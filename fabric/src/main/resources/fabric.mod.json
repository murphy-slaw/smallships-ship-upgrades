{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/murphy_slaw/examplemod"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.funkpla.smallships_upgrades.SmallshipsUpgradesFabric"
        ],
        "fabric-datagen": [
            "net.funkpla.smallships_upgrades.data.DataGenerator"
        ],
        "modmenu": [
            "net.funkpla.smallships_upgrades.ModMenuConfig"
        ],
        "cardinal-components": [
            "net.funkpla.smallships_upgrades.components.ComponentInitializer"
        ]
    },
    "custom": {
        "cardinal-components": [
            "${mod_id}:ship_upgrades"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],

    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  